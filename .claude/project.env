# Project-wide constants shared by hooks and rules. Set once by
# /bootstrap-project. Committed on purpose: a cloud container is
# rebuilt and the repo re-cloned for every session, so a value that
# was only set in an uncommitted or gitignored file would be lost
# before the next session ever saw it.

# Timezone used for every generated timestamp (filenames, dated
# reports). Must be a full IANA timezone name, e.g. Asia/Singapore,
# Europe/London, America/New_York.
PROJECT_TZ=Asia/Singapore
